+static void gofuse_vt_async_flush(AVCodecContext *avctx)
+{
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+    AVVideotoolboxContext *videotoolbox;
+    if (!vtctx || !vtctx->gofuse_async_queue)
+        return;
+    gofuse_vt_queue_seek(vtctx->gofuse_async_queue);
+    videotoolbox = videotoolbox_get_context(avctx);
+    if (videotoolbox && videotoolbox->session)
+        VTDecompressionSessionWaitForAsynchronousFrames(videotoolbox->session);
+}
