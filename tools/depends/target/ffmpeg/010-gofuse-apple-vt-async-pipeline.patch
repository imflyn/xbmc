+static int gofuse_vt_async_submit(AVCodecContext *avctx, AVFrame *frame)
+{
+    VTContext *vtctx = avctx->internal->hwaccel_priv_data;
+    AVVideotoolboxContext *videotoolbox = videotoolbox_get_context(avctx);
+    GoFuseVTQueue *queue = vtctx->gofuse_async_queue;
+    GoFuseVTTicket *ticket = NULL;
+    CMSampleBufferRef sample = NULL;
+    const void *input;
+    size_t input_size;
+    uint64_t generation;
+    GoFuseVTResult state;
+    OSStatus status;
+    VTHWFrame *ref;
+
+    if (!frame->buf[0] || !queue)
+        return AVERROR(EINVAL);
+    ref = (VTHWFrame *)frame->buf[0]->data;
+    if (ref->async_ticket)
+        return AVERROR_INVALIDDATA;
+
+    generation = gofuse_vt_queue_generation(queue);
+    state = gofuse_vt_queue_wait_capacity(queue, generation, 3000);
+    if (state != GOFUSE_VT_OK)
+        return AVERROR_EXTERNAL;
+    state = gofuse_vt_queue_reserve(queue, generation, frame->pts, &ticket);
+    if (state != GOFUSE_VT_OK)
+        return AVERROR_EXTERNAL;
+
+    state = gofuse_vt_ticket_copy_input(ticket, vtctx->bitstream, vtctx->bitstream_size);
+    if (state != GOFUSE_VT_OK)
+        goto fail;
+
+    input = gofuse_vt_ticket_input(ticket, &input_size);
+    sample = videotoolbox_sample_buffer_create(videotoolbox->cm_fmt_desc,
+                                               (void *)input, (int)input_size);
+    if (!sample)
+        goto fail;
+
+    status = VTDecompressionSessionDecodeFrame(
+        videotoolbox->session, sample,
+        kVTDecodeFrame_EnableAsynchronousDecompression, ticket, NULL);
+    CFRelease(sample);
+    if (status != noErr) {
+        if (status == kVTVideoDecoderMalfunctionErr || status == kVTInvalidSessionErr)
+            vtctx->reconfig_needed = true;
+        av_log(avctx, AV_LOG_ERROR, "GoFuse VT async submit failed: %d\n", (int)status);
+        goto fail;
+    }
+    ref->async_ticket = ticket;
+    return 0;
+
+fail:
+    gofuse_vt_ticket_complete(ticket, 0, NULL);
+    gofuse_vt_ticket_release(ticket);
+    return AVERROR_EXTERNAL;
 }
 
